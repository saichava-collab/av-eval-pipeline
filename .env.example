# Copy to .env and fill in for real BigQuery / Redshift exports.
# Without these, the python-service falls back to writing local CSVs
# under /tmp/av-eval-exports inside the container so the pipeline still
# runs end to end with no cloud accounts configured.

# --- Postgres (operational store) ---
DATABASE_URL=postgres://av_user:av_pass@localhost:5432/av_eval?sslmode=disable

# --- Go service ---
PORT=8080

# --- Python orchestrator ---
GO_SERVICE_URL=http://localhost:8080
INGEST_CHUNK_SIZE=500
PARALLEL_INGEST_WORKERS=8

# --- BigQuery export (optional) ---
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
BIGQUERY_PROJECT=my-gcp-project
BIGQUERY_DATASET=av_eval
BIGQUERY_TABLE=scenario_runs

# --- Redshift export (optional) ---
REDSHIFT_HOST=my-cluster.xxxxxxxx.us-east-1.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=av_eval
REDSHIFT_USER=av_user
REDSHIFT_PASSWORD=change_me
REDSHIFT_TABLE=scenario_runs

# --- Dashboard (build-time only, see dashboard/vite.config.js) ---
VITE_GO_API_URL=http://localhost:8080
VITE_PYTHON_API_URL=http://localhost:8000
